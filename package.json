{
  "name": "desert-peak-insurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22.6",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate:status",
    "migrate:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate-check.mts",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-db.mts",
    "test:rls": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-rls.mts",
    "verify:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-env.mts",
    "verify:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-data.mts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "test:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-media.mts",
    "test:access": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-access.mts",
    "leads:purge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/leads-purge.mts",
    "verify:glossary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-glossary.mts",
    "import:package": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-package.mts",
    "seed": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "test:referrals": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-access.mts tests/db/referrals.test.ts",
    "test:tenancy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-access.mts tests/db/tenancy.test.ts",
    "generate:content": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/generate-content.mts",
    "test:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-access.mts tests/db/generate-content.test.ts",
    "fonts:fallbacks": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/font-fallbacks.mts",
    "ux:audit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/ux-audit.mts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=mobile --project=tablet --project=desktop --project=wide",
    "test:motion": "playwright test tests/e2e/motion.spec.ts --project=mobile --project=desktop --project=wide",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:visual:update": "playwright test tests/e2e/visual.spec.ts --update-snapshots",
    "test:nojs": "playwright test tests/e2e/nojs.spec.ts --project=nojs --project=nojs-mobile",
    "test:quote-flow": "playwright test tests/e2e/quote-flow.spec.ts --project=mobile --project=desktop",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "verify:tokens": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-tokens.mts",
    "verify:routes": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-routes.mts",
    "verify:seo": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-seo.mts",
    "verify:redirects": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-redirects.mts",
    "verify:compliance": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-compliance.mts",
    "verify:uniqueness": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-uniqueness.mts",
    "test:revalidate": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/test-revalidate.mts",
    "verify:parity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-parity.mts",
    "todo:report": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/todo-report.mts",
    "fonts:subset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/font-subset.mts",
    "shell:shots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/shell-shots.mts",
    "certificates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/certificates.mts",
    "content:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content-check.mts",
    "fill:content": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/fill-content.mts",
    "mark:reviewed": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/mark-reviewed.mts",
    "verify:urls": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-urls.mts",
    "verify:sitemaps": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-sitemaps.mts",
    "verify:schema": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-schema.mts",
    "verify:og": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-og.mts",
    "verify:links": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/verify-links.mts",
    "review:stale": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/review-stale.mts",
    "rum:report": "cross-env PAYLOAD_MIGRATING=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/rum-report.mts"
  },
  "dependencies": {
    "@desert-peak/brand": "workspace:*",
    "@desert-peak/referrals": "workspace:*",
    "@payloadcms/db-postgres": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/storage-s3": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.89.0",
    "pg": "^8.20.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capsizecss/core": "^4.1.3",
    "@capsizecss/metrics": "^4.2.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.63.0",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
