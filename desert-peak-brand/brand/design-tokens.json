  "semantic": {
    "color": {
      "$description": "Roles that components reference. A component never references a primitive ramp directly. Dark theme swaps these aliases and nothing else.",
      "surface": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Page background."
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{color.neutral.0}",
        "$description": "Cards, popovers, anything lifted off the page."
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{color.neutral.100}",
        "$description": "Wells, table headers, inset areas."
      },
      "surface-inverse": {
        "$type": "color",
        "$value": "{color.neutral.950}",
        "$description": "Dark panels and footers. Pair with ink-inverse."
      },
      "ink": {
        "$type": "color",
        "$value": "{color.neutral.900}",
        "$description": "Body and heading text."
      },
      "ink-muted": {
        "$type": "color",
        "$value": "{color.neutral.600}",
        "$description": "Secondary text, captions, metadata. Still AA for body."
      },
      "ink-inverse": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Text on surface-inverse and on brand."
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.200}",
        "$description": "Hairlines and dividers. Decorative; not relied on for meaning."
      },
      "border-strong": {
        "$type": "color",
        "$value": "{color.neutral.500}",
        "$description": "Input borders and any boundary that must be perceivable (3:1)."
      },
      "brand": {
        "$type": "color",
        "$value": "{color.brand.600}",
        "$description": "Primary actions, links, the INSURANCE line of the badge."
      },
      "brand-hover": {
        "$type": "color",
        "$value": "{color.brand.700}"
      },
      "brand-active": {
        "$type": "color",
        "$value": "{color.brand.800}"
      },
      "brand-ink": {
        "$type": "color",
        "$value": "{color.neutral.50}",
        "$description": "Text and icons on brand fills."
      },
      "brand-subtle": {
        "$type": "color",
        "$value": "{color.brand.100}",
        "$description": "Tinted background for brand-flavoured panels, the recommended column, tags. brand.100, not 50: 50 is indistinguishable from surface."
      },
      "brand-subtle-ink": {
        "$type": "color",
        "$value": "{color.brand.800}",
        "$description": "Text on brand-subtle."
      },
      "accent": {
        "$type": "color",
        "$value": "{color.accent.500}",
        "$description": "Ochre rules, marks and highlights. Never text on a light surface."
      },
      "accent-strong": {
        "$type": "color",
        "$value": "{color.accent.700}",
        "$description": "Ochre where it must carry text or an icon on a light surface."
      },
      "focus-ring": {
        "$type": "color",
        "$value": "{color.neutral.900}",
        "$description": "2px ring. Always paired with focus-ring-offset as a 2px halo so it passes against both adjacent surfaces."
      },
      "focus-ring-offset": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "positive": {
        "$type": "color",
        "$value": "{color.positive.700}",
        "$description": "Positive state text and icons on surface. The three states sit on a lightness ladder (notice .47 / positive .39 / critical .31) so they stay apart without hue; re-pointing one to a step that shares another state's lightness will fail the audit."
      },
      "positive-surface": {
        "$type": "color",
        "$value": "{color.positive.50}"
      },
      "positive-border": {
        "$type": "color",
        "$value": "{color.positive.500}"
      },
      "positive-ink": {
        "$type": "color",
        "$value": "{color.positive.900}",
        "$description": "Text on positive-surface."
      },
      "notice": {
        "$type": "color",
        "$value": "{color.notice.600}",
        "$description": "Notice state text and icons on surface."
      },
      "notice-surface": {
        "$type": "color",
        "$value": "{color.notice.50}"
      },
      "notice-border": {
        "$type": "color",
        "$value": "{color.notice.500}"
      },
      "notice-ink": {
        "$type": "color",
        "$value": "{color.notice.900}"
      },
      "critical": {
        "$type": "color",
        "$value": "{color.critical.800}",
        "$description": "Critical state text and icons on surface. Never a solid fill; destructive actions are outlined. Darkest of the three states on purpose (see positive)."
      },
      "critical-surface": {
        "$type": "color",
        "$value": "{color.critical.50}"
      },
      "critical-border": {
        "$type": "color",
        "$value": "{color.critical.500}"
      },
      "critical-ink": {
        "$type": "color",
        "$value": "{color.critical.900}"
      }
    }
  },
  "typography": {
    "$description": "Two families. Archivo (variable: wght 100-900, wdth 62-125) for display and UI; Source Serif 4 (variable: wght 200-900, opsz 8-60) for long-form body. Scale is a minor third (1.2) on a 17px base, rounded to whole pixels.",
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Archivo",
          "Archivo Fallback",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Display, headings, UI, tables."
      },
      "serif": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4",
          "Source Serif Fallback",
          "Iowan Old Style",
          "Georgia",
          "serif"
        ],
        "$description": "Body copy and long-form."
      }
    },
    "width": {
      "display": {
        "$type": "number",
        "$value": 112,
        "$description": "Archivo wdth axis for display and headline steps. Slightly extended to echo the strata bands."
      },
      "ui": {
        "$type": "number",
        "$value": 100,
        "$description": "Archivo wdth axis for UI and titles."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "display": {
        "$type": "fontWeight",
        "$value": 660
      }
    },
    "scale": {
      "$description": "Minor third, ratio 1.2, base 17px. Each step pairs its own line-height and letter-spacing.",
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.sans}",
          "fontSize": "0.75rem",
          "lineHeight": 1.4,
          "letterSpacing": "0.01em",
          "fontWeight": 500
        },
        "$description": "12px. Captions, table footnotes, legal lines. Never below 12px."
      },
      "small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.sans}",
          "fontSize": "0.875rem",
          "lineHeight": 1.5,
          "letterSpacing": "0",
          "fontWeight": 400
        },
        "$description": "14px. UI text, table cells, form help."
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.serif}",
          "fontSize": "1.0625rem",
          "lineHeight": 1.6,
          "letterSpacing": "0",
          "fontWeight": 400
        },
        "$description": "17px. Long-form paragraphs. Source Serif 4 at opsz 17."
      },
      "lead": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.serif}",
          "fontSize": "1.25rem",
          "lineHeight": 1.55,
          "letterSpacing": "0",
          "fontWeight": 400
        },
        "$description": "20px. Article intros and pull text."
      },
      "title-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.sans}",
          "fontSize": "1.5rem",
          "lineHeight": 1.3,
          "letterSpacing": "-0.005em",
          "fontWeight": 600
        },
        "$description": "24px. h4, card titles."
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.family.sans}",
          "fontSize": "1.8125rem",
          "lineHeight": 1.25,
          "letterSpacing": "-0.01em",
          "fontWeight": 600
        },
        "$description": "29px. h3."
      },
      "title-lg": {
