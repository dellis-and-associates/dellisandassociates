# ──────────────────────────────────────────────────────────────
# Desert Peak Insurance — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local or .env.
# Every key here is validated at boot by src/env.ts; nothing else reads
# process.env. Run `pnpm verify:env` after editing this file.
# ──────────────────────────────────────────────────────────────

# ── Supabase Project A: customer auth + app data ──────────────
# Reached only through the Supabase client SDK. Every table here has RLS on.
# From Supabase → Project Settings → API. Must be a DIFFERENT project from
# Project B below.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-side ONLY. Used after our own authorization has run. A lint rule fails
# the build if this is imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Supabase Project B: Payload CMS database ──────────────────
# Payload owns this project entirely; its tables live in the payload_cms
# schema with RLS off (see DECISIONS.md). Nothing else is created here.
#
# Runtime (Vercel): the Transaction Pooler string, port 6543. No prepared
# statements, no SET, no LISTEN/NOTIFY through this connection.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PAYLOAD_DATABASE_URI=""
# Migrations, seeding, pg_dump, CI: the Session-mode pooler string (5432).
# The Direct host db.<ref>.supabase.co is IPv6-only; use it only from a network
# with IPv6 or the IPv4 add-on. Never the 6543 pooler for migrations.
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Local development against Docker (pnpm db:up) — put BOTH of these in .env.local:
#   PAYLOAD_DATABASE_URI="postgresql://postgres:postgres@localhost:54329/desert_peak"
#   PAYLOAD_DATABASE_URI_DIRECT="postgresql://postgres:postgres@localhost:54329/desert_peak"
# Push mode turns itself on for localhost only.
PAYLOAD_DATABASE_URI_DIRECT=""
# REQUIRED. Random 32+ char string for signing Payload auth cookies.
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=""

# ── Payload media: Supabase Storage via the S3-compatible adapter ─
# From Supabase (Project B) → Storage → S3 connection. The bucket must exist;
# public read is scoped to this bucket only. Region must match Project B.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET="desert-peak-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ── Transactional email (Resend) — optional, degrades safely ──
# Lead notifications and the one referee opt-in message. If RESEND_API_KEY is
# unset the submission is still saved, the email is skipped and a warning is
# logged. A missing key never loses a lead.
RESEND_API_KEY=""
# Inbox that receives lead notifications.
OWNER_EMAIL=""
# Verified sender on the agency's own domain, e.g. quotes@desertpeakinsurance.com
EMAIL_FROM=""

# ── Site ──────────────────────────────────────────────────────
# Public base URL for canonical, OG and the generated sitemap. No trailing slash.
# Production must be exactly https://www.desertpeakinsurance.com (src/env.schema.ts refuses anything else).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Cloudflare Turnstile — bot protection on every public form ─
# The values below are Cloudflare's always-pass TEST keys. Production refuses
# to boot with them (src/env.ts). Replace from the Cloudflare dashboard before
# go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Set automatically by the migrate:* and seed scripts; never set it by hand.
PAYLOAD_MIGRATING=""

# ── Referral engine ───────────────────────────────────────────
# Attribution cookie window in days for /r/{code}. Default 90.
REFERRAL_COOKIE_DAYS="90"
# Tenant that public routes resolve to when no tenant is on the request.
DEFAULT_TENANT_ID="desert-peak"
# Salt for hashing IP addresses in ReferralEvents. 32+ random chars.
# Generate: openssl rand -hex 32
REFERRAL_HASH_SALT=""

# ── Real-user monitoring — optional ──────────────────────────
# First-party endpoint that receives Core Web Vitals beacons.
RUM_ENDPOINT=""
RUM_WRITE_KEY=""
# "true" ships the 1 KB web-vitals beacon to /api/rum; leave empty to ship nothing.
NEXT_PUBLIC_RUM_ENABLED=""

# ── Error reporting — optional ────────────────────────────────
# Server-side only. The PII scrubber runs before any event leaves the process.
ERROR_REPORTING_DSN=""

# ── Deployment tier ───────────────────────────────────────────
# Vercel sets VERCEL_ENV itself (production | preview | development); leave it
# empty here. APP_ENV (local | preview | production) overrides it on other
# hosts. Only "production" arms the go-live guards: real Turnstile keys, https
# site URL, non-local database.
VERCEL_ENV=""
APP_ENV=""

# VERCEL_OIDC_TOKEN is written by the Vercel CLI. Never set it by hand.
