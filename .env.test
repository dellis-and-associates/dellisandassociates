# Test environment: the Docker database from docker-compose.yml and Cloudflare's
# always-pass Turnstile keys. Committed on purpose; it holds nothing secret.
# Loaded by scripts/test-access.mts (DB-backed suites only).
NODE_ENV=test
APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="test-anon-key"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key"
PAYLOAD_DATABASE_URI="postgresql://postgres:postgres@localhost:54329/desert_peak_test"
PAYLOAD_DATABASE_URI_DIRECT="postgresql://postgres:postgres@localhost:54329/desert_peak_test"
PAYLOAD_SECRET="test-secret-test-secret-test-secret-0000"
S3_ENDPOINT="http://localhost:54321/storage/v1/s3"
S3_REGION="local"
S3_BUCKET="test-media"
S3_ACCESS_KEY_ID="test"
S3_SECRET_ACCESS_KEY="test"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
DEFAULT_TENANT_ID="desert-peak"
REFERRAL_HASH_SALT="test-salt-test-salt-test-salt-test-salt"
REFERRAL_COOKIE_DAYS="90"
